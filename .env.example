# Copie para .env e preencha as chaves que for usar.
# Provedores sem chave (edge, kokoro, omnivoice, whisper, mock) funcionam sem nada aqui.

# --- TTS / STT pagos ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_TTS_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
DEEPGRAM_API_KEY=
FISH_API_KEY=

# --- Auth do próprio VoxRouter (opcional) ---
VOXROUTER_API_KEY=

# --- Bind (Docker usa 0.0.0.0) ---
VOXROUTER_HOST=0.0.0.0
VOXROUTER_PORT=8000

# --- Locais (opcional) ---
KOKORO_URL=http://kokoro:8880
OMNIVOICE_URL=http://host.docker.internal:6655
